# Stage 1: Compiling React assets
FROM node:18-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# We build the optimized, static production files here
RUN npm run build

# Stage 2: Serving static files over production Nginx
FROM nginx:stable-alpine
# Copy the compiled production assets from Stage 1 into Nginx's public folder
COPY --from=build-stage /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
